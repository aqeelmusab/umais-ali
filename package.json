{
  "name": "umais-ali",
  "version": "3.1.8",
  "private": true,
  "type": "module",
  "description": "Umais Ali: SEO Executive portfolio (Astro + Svelte 5 + Tailwind CSS 4).",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "astro sync",
    "typecheck": "astro check && pnpm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --import ./tests/support/register-loaders.mjs --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "biome check .",
    "audit": "pnpm audit --audit-level high",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm run sync && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vercel": "11.0.10",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "astro": "7.3.3",
    "dotenv": "17.4.2",
    "motion": "13.4.0",
    "resend": "6.28.1",
    "satori": "0.33.4",
    "svelte": "5.57.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.13"
  },
  "simple-git-hooks": {
    "pre-push": "(pnpm install --frozen-lockfile --lockfile-only || (echo 'Lockfile out of sync. Run pnpm install.' && exit 1)) && pnpm run typecheck && pnpm run test"
  }
}
